{
  "name": "@convex-dev/persistent-text-streaming",
  "description": "A Convex component for streaming durable text to the client, from LLMs and other sources.",
  "repository": "github:convex/persistent-text-streaming",
  "homepage": "https://github.com/convex/persistent-text-streaming#readme",
  "bugs": {
    "email": "support@convex.dev",
    "url": "https://github.com/convex/persistent-text-streaming/issues"
  },
  "version": "0.3.5",
  "license": "Apache-2.0",
  "keywords": [
    "convex",
    "component"
  ],
  "type": "module",
  "scripts": {
    "dev": "convex dev --start 'npm run dev:build'",
    "dev:frontend": "cd example && vite --clearScreen false",
    "dev:svelte": "cd example-svelte && vite --clearScreen false",
    "dev:build": "chokidar 'tsconfig*.json' 'src/**/*.ts' -i '**/*.test.ts' -c 'npm run build:codegen' --initial",
    "predev": "convex init && npm run build:codegen",
    "build": "tsc --project ./tsconfig.build.json",
    "prepack": "npm run build",
    "build:codegen": "npx convex codegen --component-dir ./src/component && npm run build",
    "build:clean": "rm -rf dist *.tsbuildinfo && npm run build:codegen",
    "typecheck": "tsc --noEmit && tsc -p example && tsc -p example/convex && svelte-check --tsconfig example-svelte/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --typecheck",
    "check": "npm run test && npm run typecheck && npm run lint",
    "test:e2e": "convex dev --once --typecheck-components",
    "test:watch": "vitest --typecheck --clearScreen false",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:coverage": "vitest run --coverage --coverage.reporter=text"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.svelte.d.ts",
      "svelte": "./dist/svelte/index.svelte.js",
      "default": "./dist/svelte/index.svelte.js"
    },
    "./test": "./src/test.ts",
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    }
  },
  "peerDependencies": {
    "convex": "^1.32.0",
    "convex-svelte": ">=0.0.12 <0.16.0",
    "react": "~18.3.1 || ^19.0.0",
    "react-dom": "~18.3.1 || ^19.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "convex-svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.0",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "chokidar-cli": "3.0.0",
    "clsx": "2.1.1",
    "convex": "1.49.0",
    "convex-svelte": "0.15.1",
    "convex-test": "0.0.67",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "openai": "7.53.0",
    "pkg-pr-new": "0.0.93",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "svelte-exmarkdown": "5.0.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "4.1.4",
    "@changesets/cli": "3.0.3"
  },
  "types": "./dist/client/index.d.ts",
  "module": "./dist/client/index.js"
}
